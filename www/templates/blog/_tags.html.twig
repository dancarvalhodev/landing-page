{% if tags is not empty %}
    <ul class="mt-3 flex flex-wrap gap-2 text-xs font-semibold text-accent">
        {% for tag in tags %}
            <li><a href="{{ i18n.url('/blog/tag/' ~ tag) }}" class="rounded-full bg-accent-soft px-3 py-1">{{ tag }}</a></li>
        {% endfor %}
    </ul>
{% endif %}
