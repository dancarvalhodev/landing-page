{% extends 'layout/base.html.twig' %}

{% block title %}{{ i18n.text('blog.title') }}{% endblock %}

{% block content %}
<main class="mx-auto max-w-2xl px-6 py-16 text-ink">
    <h1 class="text-3xl">{{ i18n.text('blog.title') }}</h1>

    <div class="mt-6 space-y-5">
        {% for post in posts %}
            <article class="rounded-box bg-surface p-5 ring-1 ring-line ring-inset">
                <time datetime="{{ post.date|date('Y-m-d') }}" class="text-xs font-semibold text-muted">
                    {{ post.date|date(i18n.locale.value == 'pt' ? 'd/m/Y' : 'M j, Y') }}
                </time>
                <h2 class="mt-1 text-lg">
                    <a href="{{ i18n.url('/blog/' ~ post.slug) }}" class="font-bold">{{ post.title }}</a>
                </h2>
                <p class="mt-1 text-sm text-muted">{{ post.description }}</p>
            </article>
        {% endfor %}
    </div>
</main>
{% endblock %}
