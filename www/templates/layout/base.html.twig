    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>{% block title %}landing-page{% endblock %}</title>
    <link rel="stylesheet" href="{{ asset('css/app.css') }}">
</head>
<body>
<header class="bg-page px-6 py-4 text-right text-sm">
