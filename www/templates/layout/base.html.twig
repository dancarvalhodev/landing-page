<!doctype html>
<html lang="{{ i18n.htmlLang }}">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>{% block title %}{{ site.name }}{% endblock %}</title>
    <meta name="description" content="{% block description %}{{ profile.intro }}{% endblock %}">
    <link rel="canonical" href="{{ canonical }}">
    <script src="{{ asset('js/theme-init.js') }}"></script>
    <link rel="stylesheet" href="{{ asset('css/app.css') }}">
</head>
<body>
<header class="bg-page flex items-center justify-between gap-4 px-6 py-4 text-sm">
    <nav class="flex items-center gap-4 font-bold">
        <a href="{{ i18n.url('/') }}">{{ i18n.text('nav.home') }}</a>
        <a href="{{ i18n.url('/blog') }}">{{ i18n.text('nav.blog') }}</a>
    </nav>
    <div class="flex items-center gap-4">
        <button type="button" data-theme-toggle aria-label="{{ i18n.text('theme.toggle') }}" class="text-lg leading-none">🌙</button>
        <a href="{{ switchUrl|default(i18n.switchUrl) }}" hreflang="{{ i18n.switchHtmlLang }}" lang="{{ i18n.switchHtmlLang }}" class="font-bold text-accent">{{ i18n.text('language.switch') }}</a>
    </div>
</header>
{% block content %}{% endblock %}
<script defer src="{{ asset('js/theme-toggle.js') }}"></script>
</body>
</html>
