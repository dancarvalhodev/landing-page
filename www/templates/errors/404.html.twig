{% extends 'layout/base.html.twig' %}

{% block title %}{{ i18n.text('error.404.title') }}{% endblock %}

{% block content %}
<main class="mx-auto max-w-2xl px-6 py-16">
    <p class="text-brand inline-block font-display text-7xl font-extrabold">404</p>
    <h1 class="mt-2 text-3xl">{{ i18n.text('error.404.title') }}</h1>
    <p class="mt-3 text-muted">{{ i18n.text('error.404.message') }}</p>
    <p class="mt-6"><a href="{{ i18n.url('/') }}" class="font-bold text-accent">{{ i18n.text('error.404.back') }}</a></p>
</main>
{% endblock %}
