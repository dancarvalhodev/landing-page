<section id="palestras" class="bg-page px-6 py-16 text-ink" data-reveal>
    <div class="mx-auto max-w-2xl">
        <h2 class="text-3xl">{{ i18n.text('home.talks.title') }}</h2>

        <div class="mt-6 grid gap-5">
            {% for talk in talks %}
                <article class="rounded-box bg-surface p-5 ring-1 ring-line ring-inset">
                    <a href="https://www.youtube.com/watch?v={{ talk.youtube|url_encode }}"
                       data-talk-player="{{ talk.youtube }}"
                       data-title="{{ talk.title }}"
                       class="flex aspect-video w-full flex-col items-center justify-center gap-4 rounded-box bg-linear-to-br from-brand-orange via-brand-rose to-brand-purple p-6 text-center text-white">
                        <span class="flex size-16 items-center justify-center rounded-full bg-white/20 ring-2 ring-white/70" aria-hidden="true">
                            <svg viewBox="0 0 24 24" class="ml-1 size-7 fill-white"><path d="M8 5v14l11-7z"/></svg>
                        </span>
                        <span class="text-xl font-bold">{{ talk.title }}</span>
                    </a>

                    <p class="mt-4 text-xs font-semibold text-muted">{{ talk.event }} · {{ talk.date }}</p>
                    <h3 class="mt-1 text-lg">{{ talk.title }}</h3>

                    {% if talk.language != i18n.locale.value %}
                        <p class="mt-2 inline-block rounded-full bg-accent-soft px-3 py-1 text-xs font-semibold text-accent">{{ i18n.text('home.talks.language.' ~ talk.language) }}</p>
                    {% endif %}
                </article>
            {% endfor %}
        </div>
    </div>
</section>
